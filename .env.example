# Browser-safe Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key. Never place a secret/service key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Auth Admin key. Never expose this through NEXT_PUBLIC_* or client code.
SUPABASE_SECRET_KEY=

# Server-only switch for a clearly labelled local/client-review experience.
# Leave empty or set to false outside an explicitly approved preview session.
# The public canonical address is NOT an environment value: the owner
# publishes it under Settings → Website (canonical base URL).
RENZ_CLIENT_PREVIEW=

# C8 public intake anti-abuse (server-only). HMAC key for the visitor identity
# hash and the signed form/upload tokens; at least 16 characters. Required in
# production — live intake refuses submissions without it. Local development
# falls back to a fixed development value.
INTAKE_RATE_LIMIT_SECRET=

# Cloudflare Turnstile. Both keys are required for enabled production intake:
# the server refuses production submissions when either is absent. Local
# development may leave them empty; never enable the dev bypass on a live host.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# C9 timed notification sweep (server-only, optional; the production runbook
# docs/RENZ_PRODUCTION_DEPLOYMENT.md describes the scheduler). When set (32+ characters) POST /api/tasks/notifications-sweep
# accepts `Authorization: Bearer <token>` and runs the idempotent sweep;
# `pnpm notifications:sweep` is the equivalent command. Leave empty locally.
RENZ_TASK_TOKEN=

# Optional. Public content cache window in seconds (default 60). The browser
# test server sets 5 so reseeded content is visible at once. Leave empty.
RENZ_PUBLIC_CACHE_SECONDS=

# Local/browser-test ONLY. Lets the intake pipeline run without the production
# anti-abuse posture. MUST be absent in a live deployment (Launch readiness
# and /api/health report it as a warning when set).
RENZ_INTAKE_ALLOW_DEV_BYPASS=

# Optional. When the supabase/migrations folder is not deployed with the app,
# set this to the latest migration version (14 digits) so the System Health
# "Database up to date" check can compare. Leave empty when the folder ships.
RENZ_LATEST_MIGRATION=
