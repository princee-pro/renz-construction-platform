for select to authenticated using (private.has_permission('content.read'));
create policy s4_project_category_localizations_staff_read on public.project_category_localizations
for select to authenticated using (private.has_permission('content.read'));
create policy s4_project_category_assignments_staff_read on public.project_category_assignments
for select to authenticated using (private.has_permission('content.read'));
create policy s4_project_services_staff_read on public.project_services
for select to authenticated using (private.has_permission('content.read'));
create policy s4_project_stages_staff_read on public.project_stages
for select to authenticated using (private.has_permission('content.read'));
create policy s4_project_media_staff_read on public.project_media
for select to authenticated using (private.has_permission('media.read') or private.has_permission('content.read'));
create policy s4_project_media_localizations_staff_read on public.project_media_localizations
for select to authenticated using (private.has_permission('media.read') or private.has_permission('content.read'));
create policy s4_posts_staff_read on public.posts
for select to authenticated using (private.has_permission('content.read'));
create policy s4_post_localizations_staff_read on public.post_localizations
for select to authenticated using (private.has_permission('content.read'));
create policy s4_post_categories_staff_read on public.post_categories
for select to authenticated using (private.has_permission('content.read'));
create policy s4_post_category_localizations_staff_read on public.post_category_localizations
for select to authenticated using (private.has_permission('content.read'));
create policy s4_post_category_assignments_staff_read on public.post_category_assignments
for select to authenticated using (private.has_permission('content.read'));
create policy s4_team_members_staff_read on public.team_members
for select to authenticated using (private.has_permission('content.read'));
create policy s4_team_member_localizations_staff_read on public.team_member_localizations
for select to authenticated using (private.has_permission('content.read'));
