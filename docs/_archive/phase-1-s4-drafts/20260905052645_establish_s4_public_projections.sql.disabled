create policy s4_navigation_items_staff_read on public.navigation_items
for select to authenticated using (private.has_permission('content.read') or private.has_permission('website.manage'));
create policy s4_navigation_localizations_staff_read on public.navigation_item_localizations
for select to authenticated using (private.has_permission('content.read') or private.has_permission('website.manage'));
create policy s4_public_settings_staff_read on public.public_site_settings
for select to authenticated using (private.has_permission('website.manage'));

revoke all on function private.service_is_public(uuid, text) from public, anon, authenticated;
revoke all on function private.project_is_public(uuid, text) from public, anon, authenticated;
revoke all on function private.post_is_public(uuid, text) from public, anon, authenticated;
revoke all on function private.page_is_public(uuid, text) from public, anon, authenticated;
revoke all on function private.team_member_is_public(uuid, text) from public, anon, authenticated;
revoke all on function private.testimonial_is_public(uuid, text) from public, anon, authenticated;
revoke all on function private.credential_is_public(uuid, text) from public, anon, authenticated;

comment on view public.public_services is
  'S4 explicit anonymous projection; no private reviewer/evidence columns.';
comment on view public.public_projects is
  'S4 explicit anonymous projection; only evidence-gated published projects.';
comment on view public.public_project_media is
  'S4 finalized derivative metadata only; raw Storage objects remain private.';
comment on view public.public_site_settings is
  'S4 allow-listed, verified, non-secret public settings only.';
