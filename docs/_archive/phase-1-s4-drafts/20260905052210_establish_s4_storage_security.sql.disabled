-- RENZ Phase 1 / S4: Storage access policy only.
-- Bucket rows and object metadata remain provider-managed. Provisioning and
-- object operations use the supported Supabase Storage API; this migration
-- creates only RLS policies on the managed objects relation.

alter table storage.objects enable row level security;

drop policy if exists s4_editorial_objects_staff_select on storage.objects;
drop policy if exists s4_editorial_objects_staff_insert on storage.objects;
drop policy if exists s4_editorial_objects_staff_update on storage.objects;
drop policy if exists s4_editorial_objects_staff_delete on storage.objects;

create policy s4_editorial_objects_staff_select
on storage.objects
for select
to authenticated
using (
  bucket_id in ('editorial-originals', 'editorial-derivatives')
  and private.has_permission('media.read')
);

create policy s4_editorial_objects_staff_insert
on storage.objects
for insert
to authenticated
with check (
  bucket_id in ('editorial-originals', 'editorial-derivatives')
  and private.has_permission('media.upload')
  and name !~ '(^|/)(\.\.?)(/|$)'
  and name !~ '[\\\\]'
  and name ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
);

create policy s4_editorial_objects_staff_update
on storage.objects
for update
to authenticated
using (
  bucket_id in ('editorial-originals', 'editorial-derivatives')
  and private.has_permission('media.manage')
)
with check (
  bucket_id in ('editorial-originals', 'editorial-derivatives')
  and private.has_permission('media.manage')
  and name !~ '(^|/)(\.\.?)(/|$)'
  and name !~ '[\\\\]'
  and name ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
);

create policy s4_editorial_objects_staff_delete
on storage.objects
for delete
to authenticated
using (
  bucket_id in ('editorial-originals', 'editorial-derivatives')
  and private.has_permission('media.manage')
);

comment on policy s4_editorial_objects_staff_select on storage.objects is
  'S4: authenticated AAL2 media.read callers may inspect controlled private buckets; anon has no read policy.';
comment on policy s4_editorial_objects_staff_insert on storage.objects is
  'S4: authenticated AAL2 media.upload callers may upload only UUID-based editorial paths.';
comment on policy s4_editorial_objects_staff_update on storage.objects is
  'S4: overwrite/move is restricted to authenticated AAL2 media.manage callers.';
comment on policy s4_editorial_objects_staff_delete on storage.objects is
  'S4: object deletion is restricted to authenticated AAL2 media.manage callers; application usage checks remain separate.';
