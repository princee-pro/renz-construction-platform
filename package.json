{
  "name": "renz-construction-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "RENZ Phase 1 application and quality foundation.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "next typegen && eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test tests/e2e/s5a-admin.spec.ts",
    "test:e2e:c4": "playwright test tests/e2e/c4-control-room.spec.ts",
    "test:e2e:c5": "playwright test tests/e2e/c5-finance.spec.ts",
    "test:e2e:c6": "playwright test tests/e2e/c6-delivery.spec.ts",
    "test:e2e:c7": "playwright test tests/e2e/c7-settings.spec.ts",
    "test:e2e:c8": "playwright test tests/e2e/c8-intake.spec.ts",
    "test:e2e:public": "playwright test tests/e2e/s6a-public.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/s5a-visual.spec.ts",
    "test:e2e:visual:public": "playwright test tests/e2e/d1-visual.spec.ts",
    "test:e2e:s9ap": "playwright test tests/e2e/s9ap-public.spec.ts",
    "test:a11y:public": "playwright test tests/e2e/s6a-public.spec.ts --grep accessibility",
    "design:lint": "designmd lint DESIGN.md",
    "design:tokens": "node scripts/design-tokens.mjs write",
    "design:tokens:check": "node scripts/design-tokens.mjs check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:test:concurrency": "node scripts/verify-lead-concurrency.mjs",
    "db:lint": "supabase db lint --local --fail-on warning",
    "db:types": "node scripts/database-types.mjs write",
    "db:types:check": "node scripts/database-types.mjs check",
    "db:verify": "node scripts/verify-database.mjs",
    "content:verify": "node scripts/verify-content-local.mjs",
    "content:publish-insights": "node scripts/content-publish-insights.mjs",
    "publication:verify": "node scripts/verify-publication-local.mjs",
    "storage:provision": "node scripts/storage.mjs provision",
    "storage:status": "node scripts/storage.mjs status",
    "storage:verify": "node scripts/storage.mjs verify",
    "storage:cleanup-test-fixtures": "node scripts/storage.mjs cleanup-test-fixtures",
    "media:reconcile": "node scripts/media-reconcile.mjs",
    "s4:verify": "node scripts/verify-s4.mjs",
    "s5a:verify": "node scripts/verify-s5a.mjs",
    "s5c:verify": "node scripts/verify-s5c.mjs",
    "s6a:verify": "node scripts/verify-s6a.mjs",
    "s9ap:preview-off": "node scripts/verify-s9ap-preview-off.mjs",
    "s9ap:measure": "node scripts/measure-public-preview.mjs",
    "s9ap:verify": "node scripts/verify-s9ap.mjs",
    "c4:verify": "node scripts/verify-c4.mjs",
    "c4:verify:realtime": "node scripts/verify-c4-realtime.mjs",
    "c5:verify": "node scripts/verify-c5.mjs",
    "c6:verify": "node scripts/verify-c6.mjs",
    "c7:verify": "node scripts/verify-c7.mjs",
    "c8:verify": "node scripts/verify-c8.mjs",
    "c9:verify": "node scripts/verify-c9.mjs",
    "test:e2e:c9": "playwright test tests/e2e/c9-intelligence.spec.ts",
    "notifications:sweep": "node scripts/notifications-sweep.mjs",
    "intake:cleanup": "node scripts/intake-cleanup.mjs",
    "intake:cleanup:purge": "node scripts/intake-cleanup.mjs purge",
    "auth:verify": "node scripts/verify-auth-local.mjs",
    "local:owner": "node scripts/local-owner.mjs create",
    "local:owner:code": "node scripts/local-owner.mjs code",
    "auth:bootstrap": "node scripts/bootstrap-super-admin.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:public-bundles": "node scripts/audit-public-bundles.mjs",
    "test:e2e:c10": "playwright test tests/e2e/c10-staff-access.spec.ts",
    "c10:verify": "node scripts/verify-c10.mjs",
    "c10:security": "node scripts/verify-c10-security.mjs",
    "c10:headers": "node scripts/c10-headers.mjs",
    "c10:scale": "node scripts/c10-scale.mjs",
    "c10:perf": "node scripts/c10-admin-perf.mjs",
    "backup:dump": "node scripts/backup.mjs dump",
    "backup:restore": "node scripts/backup.mjs restore",
    "backup:counts": "node scripts/backup.mjs counts",
    "test:e2e:r1": "playwright test tests/e2e/r1-network-failure.spec.ts",
    "r1:verify": "node scripts/verify-r1.mjs local",
    "r1:local": "node scripts/verify-r1.mjs local",
    "r1:cloud": "node scripts/verify-r1.mjs cloud",
    "r1:smoke": "node scripts/verify-r1.mjs smoke",
    "r1:bundle-scan": "node scripts/r1-bundle-scan.mjs",
    "r1:public-audit": "node scripts/r1-public-audit.mjs",
    "r1:browser-smoke": "node scripts/r1-browser-smoke.mjs",
    "r1:log-audit": "node scripts/r1-log-audit.mjs",
    "verify": "prettier . --check && next typegen && eslint . --max-warnings 0 && tsc --noEmit && vitest run --project unit && vitest run --project component && designmd lint DESIGN.md && node scripts/design-tokens.mjs check && node scripts/scan-secrets.mjs && next build && node scripts/audit-production.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "motion": "13.2.0",
    "next": "16.4.1",
    "pdfkit": "0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@google/design.md": "0.4.0",
    "@next/eslint-plugin-next": "16.4.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "sharp": "0.35.5",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.12"
  }
}
